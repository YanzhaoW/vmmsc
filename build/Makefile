dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents ../images/icons.qrc $(DISTDIR)/
	$(COPY_FILE) --parents ../include/mainwindow.h ../include/run_module.h ../include/config_handler.h ../include/configuration_module.h ../include/socket_handler.h ../include/vmmsocket.h ../include/data_handler.h ../include/calibration_module.h ../include/message_handler.h ../include/vmm_config_handler.h ../include/daq_config_handler.h ../include/commandline.h ../include/globparameter.h ../include/fec_config_handler.h ../include/guicaller.h ../include/vmm.h ../include/daq.h ../include/hybrid.h ../include/hdmi.h ../include/fec.h ../include/daq_window.h ../include/fec_window.h ../include/hdmi_window.h ../include/hybrid_window.h ../include/vmm_window.h $(DISTDIR)/
	$(COPY_FILE) --parents ../src/main.cpp ../src/mainwindow.cpp ../src/run_module.cpp ../src/config_handler.cpp ../src/configuration_module.cpp ../src/socket_handler.cpp ../src/vmmsocket.cpp ../src/data_handler.cpp ../src/calibration_module.cpp ../src/message_handler.cpp ../src/commandline.cpp ../src/vmm_config_handler.cpp ../src/daq_config_handler.cpp ../src/fec_config_handler.cpp ../src/vmm.cpp ../src/daq.cpp ../src/hybrid.cpp ../src/hdmi.cpp ../src/fec.cpp ../src/daq_window.cpp ../src/fec_window.cpp ../src/hdmi_window.cpp ../src/hybrid_window.cpp ../src/vmm_window.cpp $(DISTDIR)/
	$(COPY_FILE) --parents ../src/mainwindow.ui ../src/daq_window.ui ../src/vmm_window.ui ../src/hybrid_window.ui ../src/fec_window.ui ../src/hdmi_window.ui $(DISTDIR)/


